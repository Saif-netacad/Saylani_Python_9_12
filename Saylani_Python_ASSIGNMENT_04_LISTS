    "    \n",
    "    # Iterate over the list from the end to the beginning\n",
    "    for i in range(len(lst) - 1, -1, -1):\n",
    "        reversed_list.append(lst[i])\n",
    "    \n",
    "    return reversed_list\n",
    "\n",
