    "    words = s.split()\n",
    "    \n",
    "    # Filter out the word to delete\n",
    "    result_words = [word for word in words if word != word_to_delete]\n",
    "    \n",
    "    # Join the remaining words back into a string\n",
    "    result_string = \" \".join(result_words)\n",
